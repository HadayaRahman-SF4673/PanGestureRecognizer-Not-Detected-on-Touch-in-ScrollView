<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="panScrollSample.MainPage"
             Title="Pan gesture demo">
    <Grid RowDefinitions="*, Auto">
        <Grid x:Name="PanSurface">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="Pan_PanUpdated"/>
            </Grid.GestureRecognizers>

            <ScrollView Orientation="Vertical"
                        VerticalScrollBarVisibility="Always">
                <VerticalStackLayout x:Name="RowsLayout"/>
            </ScrollView>
        </Grid>
        <Label x:Name="PanStatusLabel"
               Grid.Row="1"
               Text="Pan with mouse or touch"
               BackgroundColor="White"
               TextColor="Black"
               Padding="8"
               HorizontalOptions="Center"
               VerticalOptions="End"
               InputTransparent="True"/>
    </Grid>
</ContentPage>
